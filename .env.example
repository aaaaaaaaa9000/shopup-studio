# Required: Gemini API key (server-side only, never sent to the browser)
GEMINI_API_KEY=

# Every standard edit (~3 s)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# 2K / 4K results
GEMINI_HQ_IMAGE_MODEL=gemini-3.1-flash-image
# Describes a style reference image
GEMINI_MODEL=gemini-3.8-flash
# Finds the pieces in a model photo
GEMINI_ANALYZE_MODEL=gemini-3.5-flash

# In-page login form + session cookie. Leave APP_PASSWORD empty to disable.
APP_USERNAME=user
APP_PASSWORD=
# Days a login stays valid on a device
SESSION_DAYS=180
# Optional signing key for session cookies (defaults to one derived from the password)
SESSION_SECRET=

# Abuse limits (shared by all sections, per IP)
RATE_LIMIT_PER_MINUTE=30
MAX_IMAGE_MB=12

PORT=3000
# Domain used by Traefik in docker-compose.yml
APP_DOMAIN=studio.aaaaaaaaa9000.cloud
